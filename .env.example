# Gemini API key — used by the forensic agent / report generator
GOOGLE_API_KEY=

# Turso hosted SQLite (leave blank to use local data/forensic.db)
# Sign up at https://turso.tech, create a DB, then:
#   turso db show <name> --url
#   turso db tokens create <name>
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
